pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building DevOps website...'
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing website files...'
                sh 'test -f index.html'
                sh 'test -f style.css'
                sh 'test -s index.html'
                sh 'test -s style.css'
                echo 'Website tests passed.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying website to Nginx...'
                sh 'cp index.html /deploy/index.html'
                sh 'cp style.css /deploy/style.css'
                echo 'Website deployed successfully!'
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'CI/CD Pipeline failed.'
        }
    }
}